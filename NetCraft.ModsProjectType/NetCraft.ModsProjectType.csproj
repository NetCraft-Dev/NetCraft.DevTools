<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NetCraft mod project template package.
    After packing, dotnet new install NetCraft.ModsProjectType enables dotnet new ncm.
    content/ncm/Build/kernel/ ships reference assemblies, so pack syncs them from
    reference/ first to avoid shipping stale interfaces.
  -->

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>NetCraft.ModsProjectType</PackageId>
    <Description>NetCraft mod project template, create with dotnet new ncm</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5128 empty dependency group and NU5100 because template reference assemblies must not live under lib/ -->
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <!-- The template contains .cs files meant for generated projects, so they must not be compiled as this package's source -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Source for the sync, defaults to this repo's reference/ and can be overridden -->
    <NetCraftRuntimeDir Condition="'$(NetCraftRuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\reference</NetCraftRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      All template files go into the package, except Build\kernel (added by
      SyncNetCraftLibs) and obj/bin, whose build leftovers would otherwise leak
      into every new project.
    -->
    <None Include="content\**\*"
          Exclude="content\ncm\Build\kernel\**\*;content\ncm\obj\**\*;content\ncm\bin\**\*"
          Pack="true" PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    SyncNetCraftLibs copies the kernel reference assemblies into the template and adds
    them to the package; the item must be added at this point because Build\kernel does
    not exist yet on the first pack, so the evaluation-time None glob misses it and the
    package would ship without reference assemblies.
  -->
  <Target Name="SyncNetCraftLibs" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <NetCraftLibSource Include="$(NetCraftRuntimeDir)\*.dll" />
      <NetCraftLibOutput Include="$(MSBuildThisFileDirectory)content\ncm\Build\kernel" />
    </ItemGroup>
    <Error Condition="'@(NetCraftLibSource)' == ''"
           Text="No NetCraft reference assemblies found; check the directory NetCraftRuntimeDir points to: $(NetCraftRuntimeDir)" />
    <MakeDir Directories="@(NetCraftLibOutput)" />
    <Copy SourceFiles="@(NetCraftLibSource)" DestinationFolder="@(NetCraftLibOutput)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)content\ncm\Build\kernel\*.dll" Pack="true" PackagePath="content\ncm\Build\kernel\" />
    </ItemGroup>
    <Message Importance="high" Text="Synced @(NetCraftLibSource->Count()) NetCraft reference assemblies -> content\ncm\Build\kernel" />
  </Target>

</Project>
