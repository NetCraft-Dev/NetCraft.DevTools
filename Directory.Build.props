<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup>
    <!-- 目标框架：.NET 10 -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- 语言版本：最新（C# 14 / .NET 10） -->
    <LangVersion>latest</LangVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 中性资源语言 -->
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>NetCraft Contributors</Authors>
    <Product>NetCraft</Product>
    <Copyright>Copyright (c) NetCraft Contributors</Copyright>

    <!-- ncm 与项目模板共用同一个版本号 发版时改这里 -->
    <VersionPrefix>0.5.2</VersionPrefix>
    <AssemblyVersion>0.5.2.0</AssemblyVersion>
    <FileVersion>0.5.2.0</FileVersion>
  </PropertyGroup>

</Project>
